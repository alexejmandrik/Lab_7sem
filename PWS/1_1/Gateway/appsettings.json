{
  "ReverseProxy": {
    "Routes": {
      "stack-route": {
        "ClusterId": "stack-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "stack-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "HashCookie",
          "AffinityKeyName": "GatewayAffinity",
          "FailurePolicy": "Redistribute",
          "Cookie": {
            "HttpOnly": true,
            "IsEssential": true,
            "Path": "/",
            "SameSite": "Lax"
          }
        },
        "Destinations": {
          "server1": {
            "Address": "http://ws01-01-1:8080/"
          },
          "server2": {
            "Address": "http://ws01-01-2:8080/"
          }
        }
      }
    }
  }
}
