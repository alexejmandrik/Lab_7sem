<?xml version="1.0"?>

<configuration>

	<system.web>

		<compilation debug="false"
					 targetFramework="4.7.2" />

	</system.web>

	<system.webServer>

		<handlers>
			<add name="MAIRestHandler"
				 path="*.MAI"
				 verb="GET,POST,PUT,DELETE"
				 type="Lab_01.RestHandler, Lab_01"
				 resourceType="Unspecified" />
		</handlers>

	</system.webServer>

</configuration>